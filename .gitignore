# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# The jest cache CI keeps inside the checkout.
/.jest-cache/

# Node / Bun / frontend
node_modules/
dist/
dist-web/
atlas-journal-web-*.tar.gz
# nix build outputs
result
result-*
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.local

# Android (signing keystores never belong in the repo)
.android/
*.jks
*.keystore
local.properties
*.apk
*.aab
apps/journal/android/
apps/journal/ios/
apps/journal/.expo/
# The local Expo modules' Gradle output from a native build.
apps/journal/modules/*/android/build/
apps/journal/modules/*/android/.gradle/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.claude/

# Generated by scripts/third-party-licenses.mjs (CI and release builds)
THIRD_PARTY_NOTICES.txt
